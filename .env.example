# Copy to .env on the droplet. Never commit .env.

TELEMETRY_SQLITE=/data/telemetry.sqlite

TELEMETRY_HTTP_ENABLED=true
TELEMETRY_HTTP_HOST=0.0.0.0
TELEMETRY_HTTP_PORT=4200
TELEMETRY_HTTP_API_KEY=change-me

TELEMETRY_TCP_ENABLED=true
TELEMETRY_TCP_HOST=0.0.0.0
TELEMETRY_TCP_PORT=4210

WANWAY_TCP_ENABLED=true
WANWAY_TCP_HOST=0.0.0.0
WANWAY_TCP_PORTS=21100,5001,8821

TELEMETRY_MQTT_ENABLED=false

# Same MongoDB as Fleetel-Switchride API
MONGODB_URI=mongodb+srv://USER:PASS@HOST/switchride

# Optional: place names + dual-write into the platform API
LOCATION_API_URL=https://fleetel-switchride-pmxt5.ondigitalocean.app/geo
LOCATION_API_PATH=/v1/locations/reverse
PLATFORM_API_URL=https://fleetel-switchride-pmxt5.ondigitalocean.app
PLATFORM_TELEMETRY_PATH=/api/v1/internal/iot/telemetry
